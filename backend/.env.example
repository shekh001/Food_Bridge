PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/foodbridge
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Browser push notifications (optional — leave blank to disable push silently).
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@foodbridge.app

# Payments (optional — leave blank and the Pro upgrade runs in demo/simulated mode).
# Get free TEST-mode keys instantly at dashboard.razorpay.com (no business KYC needed
# for test mode). Never put LIVE keys here until you've registered a real business.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Outgoing email for password-reset links (optional — leave blank and the
# reset link is returned directly in the API response instead, so the flow
# still works end to end in local/demo environments without a mail server).
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc.).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FoodBridge <no-reply@foodbridge.app>

# Error monitoring (optional — leave blank and errors just go to console/host logs).
# Free tier: sentry.io -> New Project -> Node.js -> copy the DSN it gives you.
SENTRY_DSN=

# File storage (optional — leave blank and uploads (verification docs, report
# evidence, listing photos) save to local disk instead). Fine for local dev,
# but on Render's free tier local disk is wiped on every redeploy/restart —
# set these before real users start uploading things they'd be upset to lose.
# Free forever tier at cloudinary.com (no credit card): sign up -> Dashboard
# -> copy Cloud Name / API Key / API Secret from the "Account Details" card.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
